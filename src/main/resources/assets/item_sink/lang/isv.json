{
  "itemGroup.item_sink": "Create: Prěměnitelj predmetov",
  "block.item_sink.item_sink": "Prěměnitelj predmetov",
  "item_sink.ponder.item_sink_basics.header": "Uživanje prětvornika prědmetov",
  "item_sink.ponder.item_sink_basics.text_1": "Prětvornik měnjaje nepotrěbne prědmety v novce, jedin prědmet za jeden obrabotny cikl.",
  "item_sink.ponder.item_sink_basics.text_2": "Klikni pravym klavišem, da by otvoriti stroj. Položi prijemlivy prědmet v vhodno město na lěvo.",
  "item_sink.ponder.item_sink_basics.text_3": "Prijmajut se toliko nastavljene vhody s dostupnymi izhodnymi novcami. Pogledaj recepty prětvarjanja v JEI.",
  "item_sink.ponder.item_sink_basics.text_4": "Obično stroj potrěbuje Forge Energy (FE) od generatora ili baterije. Energija može vhoditi iz vsakoj strany; pokazatelj jest na lěvo.",
  "item_sink.ponder.item_sink_basics.text_5": "Stroj světli pri obrabotkě. Strělka postupa se napolnjaje pri potrěbljanju FE. Čas i cena zavisęt od vrijednostnoj urovnje prědmeta.",
  "item_sink.ponder.item_sink_basics.text_6": "Vozmi novce iz dvoh izhodnyh měst na pravo. Vsaky zakončeny cikl potrěbljaje jedin vhodny prědmet.",
  "item_sink.ponder.item_sink_basics.text_7": "Obične izhody sut monety Create: Numismatics. Bez Numismatics nastavi outputItem v item_sink-common.toml na ustanovjeny prědmet, napr. minecraft:emerald.",
  "item_sink.ponder.item_sink_automation.header": "Avtomatizacija prětvornika",
  "item_sink.ponder.item_sink_automation.text_1": "Nasypnik može podavati prijemlive prědmety. Tuta skrinja i nasypnik napolnjajut vhod s vrhu.",
  "item_sink.ponder.item_sink_automation.text_2": "Drugy nasypnik izvlači novce v skrinju. Avtomatika izvlači toliko iz dvoh izhodnyh měst; neobrabotane prědmety ostavajut vnutri.",
  "item_sink.ponder.item_sink_automation.text_3": "Podavaj FE, kogda stroj rabotaje. Vhod prědmetov, izhod novcev i vhod FE sut dostupne na vsakoj straně.",
  "item_sink.ponder.item_sink_automation.text_4": "Obrabotka se zaustavjaje, kogda ne jest města za slědujuče plačenje ili FE konči. Osvobodi izhod i podavaj energiju.",
  "item_sink.ponder.item_sink_automation.text_5": "Kogda jest město za novce i dostatočno FE, obrabotka prodolžaje avtomatično.",
  "jei.item_sink.item_sink_conversion": "Prěměna predmetov",
