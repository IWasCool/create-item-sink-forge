{
  "itemGroup.item_sink": "Create: Przetwornik przedmiotów",
  "block.item_sink.item_sink": "Przetwornik przedmiotów",
  "item_sink.ponder.item_sink_basics.header": "Korzystanie z Przetwornik przedmiotów",
  "item_sink.ponder.item_sink_basics.text_1": "Przetwornik przedmiotów zamienia niechciane przedmioty na walutę, jeden przedmiot na cykl przetwarzania.",
  "item_sink.ponder.item_sink_basics.text_2": "Kliknij prawym przyciskiem myszy, aby otworzyć maszynę. Umieść zaakceptowany przedmiot w gnieździe wejściowym po lewej stronie.",
  "item_sink.ponder.item_sink_basics.text_3": "Akceptowane są tylko skonfigurowane wejścia z dostępnym wyjściem walutowym. Po zainstalowaniu JEI sprawdź przepisy Przetwarzanie przedmiotów.",
  "item_sink.ponder.item_sink_basics.text_4": "Domyślnie Przetwornik przedmiotów potrzebuje Forge Energy (FE) z generatora lub akumulatora. Władza może wejść dowolną stroną; pasek energii znajduje się po lewej stronie ekranu.",
  "item_sink.ponder.item_sink_basics.text_5": "Maszyna świeci się podczas obróbki. Strzałka postępu zapełnia się w miarę zużywania FE. Czas i koszt FE zależą od poziomu wartości przedmiotu.",
  "item_sink.ponder.item_sink_basics.text_6": "Zbierz walutę z dwóch pól wyjściowych po prawej stronie. Każdy ukończony cykl zużywa jeden element wejściowy.",
  "item_sink.ponder.item_sink_basics.text_7": "Domyślne wyniki to Create: Numismatics monet. Bez Numismatics ustaw outputItem na zainstalowany element, taki jak minecraft:emerald, w item_sink-common.toml.",
  "item_sink.ponder.item_sink_automation.header": "Automatyzacja Przetwornik przedmiotów",
  "item_sink.ponder.item_sink_automation.text_1": "Podaj zaakceptowane produkty do Przetwornik przedmiotów za pomocą leja. Ta skrzynia i zbiornik zaopatrują szczelinę wejściową od góry.",
  "item_sink.ponder.item_sink_automation.text_2": "Drugi hopper wydobywa walutę do skrzyni. Automatyzacja wyodrębnia tylko z dwóch gniazd wyjściowych, więc nieprzetworzone dane wejściowe pozostają w środku.",
  "item_sink.ponder.item_sink_automation.text_3": "Należy dostarczać FE podczas pracy maszyny. Wstawianie przedmiotów, ekstrakcja walut i wprowadzanie danych FE są dostępne z każdej strony.",
  "item_sink.ponder.item_sink_automation.text_4": "Przetwarzanie zostaje wstrzymane, gdy miejsca wyjściowe nie mieszczą się w następnej wypłacie lub gdy skończy się FE. Utrzymuj czystość sygnału wyjściowego i zasilanie maszyny.",
  "item_sink.ponder.item_sink_automation.text_5": "Gdy pojawi się już miejsce na walutę i wystarczająca ilość FE, przetwarzanie zostanie wznowione automatycznie.",
