{
  "itemGroup.item_sink": "Create: Asjõmuutja",
  "block.item_sink.item_sink": "Asjõmuutja",
  "item_sink.ponder.item_sink_basics.header": "Asjõmuutja pruukminõ",
  "item_sink.ponder.item_sink_basics.text_1": "Asjõmuutja muut tarõtuid asju rahas, üts asi egä tüütsõõri kotussõ.",
  "item_sink.ponder.item_sink_basics.text_2": "Tee hääklahviga klõps, et masinat vallalõ tetä. Panõ sobiv asi vasakul olõvahe sissepandmisõ kotussõ.",
  "item_sink.ponder.item_sink_basics.text_3": "Vastu võetas õnnõ säädetüid asju, mille rahaväljund om olõman. Vahtõq JEI-st asjõmuutmisõ retsepte.",
  "item_sink.ponder.item_sink_basics.text_4": "Harilikult taht masin Forge Energy (FE) võimu generaatorist vai akust. Võim või tulla egäst küljest; võimuriba om pildi vasakul puul.",
  "item_sink.ponder.item_sink_basics.text_5": "Tüü aol masin paistus. Edüminegunool täütüs, ku FE-d pruugitas. Aig ja FE kulu olõnõs asja väärtusõst.",
  "item_sink.ponder.item_sink_basics.text_6": "Võtaq raha kahõst väländmisõ kotussõst hüäl puul. Egä tettü tüütsõõr pruuk üte asja.",
  "item_sink.ponder.item_sink_basics.text_7": "Harilikult tulõvaq Create: Numismatics mündiq. Ku Numismatics puudus, sääq outputItem failin item_sink-common.toml olõman asjas, näütüses minecraft:emerald.",
  "item_sink.ponder.item_sink_automation.header": "Asjõmuutja automaatsõs tegemine",
  "item_sink.ponder.item_sink_automation.text_1": "Kol´u või masinalõ sobivit asju anda. Seo kirst ja kol´u täütväq sissepandmisõ kotussõ päältpuult.",
  "item_sink.ponder.item_sink_automation.text_2": "Tõõnõ kol´u vii raha kirstu. Automaatnõ võtminõ pruuk õnnõ kattõ väländmisõ kotust; muutmalda asjaq jääväq sisse.",
  "item_sink.ponder.item_sink_automation.text_3": "Annaq tüü aol masinalõ FE-d. Asjõ sissepandminõ, raha väländminõ ja FE andminõ tüü tä egäst küljest.",
  "item_sink.ponder.item_sink_automation.text_4": "Tüü jääs saisma, ku järgmädsele rahalõ ei olõ ruumi vai FE saa otsa. Tiikõq väljund tühäs ja andkõq võimu.",
  "item_sink.ponder.item_sink_automation.text_5": "Ku rahalõ om ruumi ja FE-d om külländ, nakas masin esiq jälq tüüd tegemä.",
  "jei.item_sink.item_sink_conversion": "Asjõ muutminõ",
