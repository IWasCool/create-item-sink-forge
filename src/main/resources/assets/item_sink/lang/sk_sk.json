{
  "itemGroup.item_sink": "Create: Prevodník predmetov",
  "block.item_sink.item_sink": "Prevodník predmetov",
  "item_sink.ponder.item_sink_basics.header": "Používanie prevodníka predmetov",
  "item_sink.ponder.item_sink_basics.text_1": "Prevodník premieňa nepotrebné predmety na menu, jeden predmet za pracovný cyklus.",
  "item_sink.ponder.item_sink_basics.text_2": "Kliknutím pravým tlačidlom otvor stroj. Vlož prijímaný predmet do vstupného miesta vľavo.",
  "item_sink.ponder.item_sink_basics.text_3": "Prijímajú sa iba nastavené vstupy s dostupnou výstupnou menou. Recepty prevodu predmetov nájdeš v JEI.",
  "item_sink.ponder.item_sink_basics.text_4": "Štandardne stroj potrebuje Forge Energy (FE) z generátora alebo batérie. Energia môže vstupovať zo všetkých strán. Ukazovateľ energie je naľavo.",
  "item_sink.ponder.item_sink_basics.text_5": "Počas spracovania stroj svieti. Šípka postupu sa plní a spotrebúva sa FE. Čas a cena energie závisia od hodnotovej úrovne predmetu.",
  "item_sink.ponder.item_sink_basics.text_6": "Vyber menu z dvoch výstupných miest napravo. Každý dokončený cyklus spotrebuje jeden vstupný predmet.",
  "item_sink.ponder.item_sink_basics.text_7": "Predvolené výstupy sú mince z Create: Numismatics. Bez Numismatics nastav outputItem v item_sink-common.toml na nainštalovaný predmet, napríklad minecraft:emerald.",
  "item_sink.ponder.item_sink_automation.header": "Automatizácia prevodníka predmetov",
  "item_sink.ponder.item_sink_automation.text_1": "Násypka môže vkladať prijímané predmety. Táto truhlica a násypka zásobujú vstup zhora.",
  "item_sink.ponder.item_sink_automation.text_2": "Druhá násypka odoberá menu do truhlice. Automatizácia odoberá iba z dvoch výstupných miest, takže nespracované vstupy zostávajú vnútri.",
  "item_sink.ponder.item_sink_automation.text_3": "Počas práce dodávaj FE. Vkladanie predmetov, odoberanie meny aj prívod FE sú dostupné na každej strane.",
  "item_sink.ponder.item_sink_automation.text_4": "Spracovanie sa pozastaví, keď sa ďalšia výplata nezmestí do výstupu alebo dôjde FE. Uvoľni výstup a napájaj stroj.",
  "item_sink.ponder.item_sink_automation.text_5": "Keď je dosť miesta na menu a dostatok FE, spracovanie sa automaticky obnoví.",
