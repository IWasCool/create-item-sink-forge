{
  "itemGroup.item_sink": "Create: Item Sink",
  "block.item_sink.item_sink": "Item Sink",
  "item_sink.ponder.item_sink_basics.header": "Item Sink: 𐌱𐍂𐌿𐌺𐍃",
  "item_sink.ponder.item_sink_basics.text_1": "1 𐍅𐌰𐌹𐌷𐍄𐌰 -> Item Sink -> 𐍆𐌰𐌹𐌷𐌿 / ↻.",
  "item_sink.ponder.item_sink_basics.text_2": "𐌺𐌽𐌰𐍀𐍀𐌰 𐍄𐌰𐌹𐌷𐍃𐍅𐌰: Item Sink. 𐍅𐌰𐌹𐌷𐍄𐌰 -> [ <- ].",
  "item_sink.ponder.item_sink_basics.text_3": "𐌲𐌰𐍅𐌰𐌻𐌴𐌹𐌽𐍉𐍃: 𐍅𐌰𐌹𐌷𐍄𐌰 -> 𐍆𐌰𐌹𐌷𐌿. JEI: Item Sink Conversion.",
  "item_sink.ponder.item_sink_basics.text_4": "Forge Energy (FE) -> Item Sink: ↑ ↓ ← →. FE: [ <- ].",
  "item_sink.ponder.item_sink_basics.text_5": "𐍅𐌰𐌿𐍂𐍃𐍄𐍅: 0 -> 1; FE. 𐍅𐌰𐌹𐌷𐍄𐌰: ¤ -> t + FE.",
  "item_sink.ponder.item_sink_basics.text_6": "2 [ -> ]: 𐍆𐌰𐌹𐌷𐌿 ->. 1 𐍅𐌰𐌹𐌷𐍄𐌰 / ↻.",
  "item_sink.ponder.item_sink_basics.text_7": "Create: Numismatics -> 𐍆𐌰𐌹𐌷𐌿. Numismatics = 0: item_sink-common.toml: outputItem = minecraft:emerald.",
  "item_sink.ponder.item_sink_automation.header": "Item Sink: 𐍅𐌰𐌿𐍂𐍃𐍄𐍅 ↻",
  "item_sink.ponder.item_sink_automation.text_1": "𐌰𐍂𐌺𐌰 -> 𐌹𐌽𐌲𐌿𐍄𐌾𐌰 -> Item Sink. ↑ -> [ <- ].",
  "item_sink.ponder.item_sink_automation.text_2": "2 [ -> ] -> 𐌹𐌽𐌲𐌿𐍄𐌾𐌰 -> 𐌰𐍂𐌺𐌰. 𐍅𐌰𐌹𐌷𐍄𐌰: [ Item Sink ].",
  "item_sink.ponder.item_sink_automation.text_3": "𐍅𐌰𐌹𐌷𐍄𐌰 ->, 𐍆𐌰𐌹𐌷𐌿 <-, FE ->: ↑ ↓ ← →.",
  "item_sink.ponder.item_sink_automation.text_4": "FE = 0 / 𐍂𐌿𐌼𐍃 = 0 -> 𐌽𐌹 𐍅𐌰𐌿𐍂𐍃𐍄𐍅.",
  "item_sink.ponder.item_sink_automation.text_5": "FE >= FE/t + 𐍂𐌿𐌼𐍃 >= 𐍆𐌰𐌹𐌷𐌿 -> 𐍅𐌰𐌿𐍂𐍃𐍄𐍅 ↻.",
