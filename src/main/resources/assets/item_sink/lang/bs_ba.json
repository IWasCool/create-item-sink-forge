{
  "itemGroup.item_sink": "Create: Pretvarač predmeta",
  "block.item_sink.item_sink": "Pretvarač predmeta",
  "item_sink.ponder.item_sink_basics.header": "Korištenje Pretvarač predmeta",
  "item_sink.ponder.item_sink_basics.text_1": "Pretvarač predmeta pretvara neželjene stavke u valutu, jednu stavku po ciklusu obrade.",
  "item_sink.ponder.item_sink_basics.text_2": "Kliknite desnim tasterom miša da otvorite mašinu. Stavite prihvaćenu stavku u ulazni slot sa leve strane.",
  "item_sink.ponder.item_sink_basics.text_3": "Prihvataju se samo konfigurirani ulazi s dostupnim izlazom valute. Sa instaliranim JEI provjerite Pretvaranje predmeta recepata.",
  "item_sink.ponder.item_sink_basics.text_4": "Podrazumevano, Pretvarač predmeta treba Forge Energy (FE) iz generatora ili baterije. Moć može ući kroz bilo koju stranu; energetska traka je na lijevoj strani ekrana.",
  "item_sink.ponder.item_sink_basics.text_5": "Mašina svijetli tokom obrade. Strelica napretka se popunjava dok troši FE. Vrijeme i trošak FE zavise od nivoa vrijednosti stavke.",
  "item_sink.ponder.item_sink_basics.text_6": "Sakupite valutu iz dva izlazna slota na desnoj strani. Svaki završeni ciklus troši jednu ulaznu stavku.",
  "item_sink.ponder.item_sink_basics.text_7": "Zadani izlazi su Create: Numismatics novčića. Bez Numismatics, postavite outputItem na instaliranu stavku, kao što je minecraft:emerald, u item_sink-common.toml.",
  "item_sink.ponder.item_sink_automation.header": "Automatizacija Pretvarač predmeta",
  "item_sink.ponder.item_sink_automation.text_1": "Ubacite prihvaćene artikle u Pretvarač predmeta pomoću spremnika. Ovaj sanduk i lijevak opskrbljuju ulazni otvor odozgo.",
  "item_sink.ponder.item_sink_automation.text_2": "Drugi spremnik izvlači novac u škrinju. Automatizacija izdvaja samo iz dva izlazna slota, tako da neobrađeni ulazi ostaju unutra.",
  "item_sink.ponder.item_sink_automation.text_3": "Držite FE isporučen dok mašina radi. Umetanje stavke, izvlačenje valute i unos FE dostupni su sa svake strane.",
  "item_sink.ponder.item_sink_automation.text_4": "Obrada se pauzira kada izlazni slotovi ne mogu da stane na sljedeću isplatu, ili kada FE istekne. Neka izlaz bude čist i mašina napajana.",
  "item_sink.ponder.item_sink_automation.text_5": "Kada bude prostora za valutu i dovoljno FE, obrada se automatski nastavlja.",
