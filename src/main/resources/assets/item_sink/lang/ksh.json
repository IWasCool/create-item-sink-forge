{
  "itemGroup.item_sink": "Create: Dengsverwerter",
  "block.item_sink.item_sink": "Dengsverwerter",
  "item_sink.ponder.item_sink_basics.header": "Dä Dengsverwerter bruche",
  "item_sink.ponder.item_sink_basics.text_1": "Dä Dengsverwerter mäht us Dengern, die de nit bruchs, Jeld. Pro Döschjang weed e Deng verbrucht.",
  "item_sink.ponder.item_sink_basics.text_2": "Maach de Maschin met enem Räächtsklick op. Lääsch e passend Deng en dä Plaz för de Engab links.",
  "item_sink.ponder.item_sink_basics.text_3": "Nur enjestallte Denger met enem vörhandene Jeld als Ußgab wäde jenomme. De Rezepte för et Verwerte fings de en JEI.",
  "item_sink.ponder.item_sink_basics.text_4": "Normal bruch de Maschin Forge Energy (FE) us enem Jenerator udder Akku. Stroum kann vun jeder Sigg eren; dä Energiebalke es links.",
  "item_sink.ponder.item_sink_basics.text_5": "Beim Ärbeide lüch de Maschin. Dä Piel för dä Fottjank füllt sich un FE weed verbrucht. Zick un FE-Koste hange vum Wäät vum Deng aff.",
  "item_sink.ponder.item_sink_basics.text_6": "Holl et Jeld us dä zwei Ußjabeplätz räächts. Jeder fäädije Döschjang verbrüch e Deng.",
  "item_sink.ponder.item_sink_basics.text_7": "Normal kütt Jeld vun Create: Numismatics eruß. Ohne Numismatics moß de outputItem en item_sink-common.toml op e installier Deng wie minecraft:emerald stelle.",
  "item_sink.ponder.item_sink_automation.header": "Dä Dengsverwerter automattesch bedriive",
  "item_sink.ponder.item_sink_automation.text_1": "Ene Trichter kann passende Denger erengevve. Die Kess un dä Trichter fülle dä Engab vun bovve.",
  "item_sink.ponder.item_sink_automation.text_2": "Ene zweite Trichter holt et Jeld en en Kess. Automattesch weed nur us dä zwei Ußjabeplätz jenomme; unverarbeit Denger blieve dren.",
  "item_sink.ponder.item_sink_automation.text_3": "Versorg de Maschin met FE. Denger erengevve, Jeld erußholle un FE erinleide jeiht vun jeder Sigg.",
  "item_sink.ponder.item_sink_automation.text_4": "Wann för et nächste Jeld kein Plaz es udder FE fählt, hööt de Maschin op. Halt de Ußjab frei un jeff ehr Stroum.",
  "item_sink.ponder.item_sink_automation.text_5": "Es widder Plaz för et Jeld un jenoch FE do, jeiht et automattesch widder.",
