{
  "itemGroup.item_sink": "Create: Dávvirrievdadeaddji",
  "block.item_sink.item_sink": "Dávvirrievdadeaddji",
  "item_sink.ponder.item_sink_basics.header": "Geavahit Dávvirrievdadeaddji",
  "item_sink.ponder.item_sink_basics.text_1": "Dávvirrievdadeaddji rievdada sávakeahtes ávdnasiid valutan, okta ávnnas juohke gieđahallanáigodagas.",
  "item_sink.ponder.item_sink_basics.text_2": "Deadde olgešbealde vai rahpat mašiinna. Bija dohkkehuvvon ávdnasa sisačállinbáikái olgešbealde.",
  "item_sink.ponder.item_sink_basics.text_3": "Dušše konfigurerejuvvon sisaboađut main lea gávdnamis valutaboađus dohkkehuvvojit. Go JEI lea installerejuvvon, de geahča Dávviriid rievdadeapmi rávvagiid.",
  "item_sink.ponder.item_sink_basics.text_4": "Dávvirrievdadeaddji dárbbaša Forge Energy (FE) generatoras dahje batteriijas. Fápmu sáhttá boahtit vaikko makkár bealis; energiijačuokkis lea čájáhusa olgešbealde.",
  "item_sink.ponder.item_sink_basics.text_5": "Mašiidna čuovgá gieđahallama áigge. Ovdáneami čuovga deavdá go geavaha FE. Áigi ja FE golut leat gitta ávdnasa árvodásis.",
  "item_sink.ponder.item_sink_basics.text_6": "Čoaggit valuta dan guovtti olggosbuktinbáikkis olgešbealde. Juohke čađahuvvon syklus geavaha ovtta sisačálihančuoggá.",
  "item_sink.ponder.item_sink_basics.text_7": "Default-bohtosat leat Create: Numismatics ruđa. Jus ii leat Numismatics, de bidjat outputItem installerejuvvon ávdnasii, nugo minecraft:emerald, item_sink-common.toml:s.",
  "item_sink.ponder.item_sink_automation.header": "Automatiseren Dávvirrievdadeaddji",
  "item_sink.ponder.item_sink_automation.text_1": "Bija dohkkehuvvon ávdnasiid Dávvirrievdadeaddji:ii čáhcebohcciin. Dát skáhppu ja čáhcebohcci fállet sisaváldinbáikki bajil.",
  "item_sink.ponder.item_sink_automation.text_2": "Nubbi čáhcebohcci čoaggá ruđa skáhppon. Automatiseren čoaggá dušše dan guovtti olggosbuktinbáikkis, nu ahte gieđahallakeahtes sisaboađut bissot siskkobealde.",
  "item_sink.ponder.item_sink_automation.text_3": "Doala FE mielde dan botta go mašiidna doaibmá. Ávdnasiid sisačáliheapmi, valutaváldin ja FE sisačáliheapmi leat gávdnamis juohke bealde.",
  "item_sink.ponder.item_sink_automation.text_4": "Gieđahallan bisána go olggosbuktinbáikkit eai heive boahtte máksimii, dahje go FE nohká. Doala bohtosa čielggasin ja mášiinna doaibmi.",
  "item_sink.ponder.item_sink_automation.text_5": "Go lea sadji ruđaide ja doarvái FE, de álgá gieđahallan fas automáhtalaččat.",
