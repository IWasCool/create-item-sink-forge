{
  "itemGroup.item_sink": "Create: Nati-vistar",
  "block.item_sink.item_sink": "Nati-vistar",
  "item_sink.ponder.item_sink_basics.header": "Yuhta i nati-vistar",
  "item_sink.ponder.item_sink_basics.text_1": "I nati-vistar vista úmauyë nati mir telpe. Minë nat vanya mi ilya carmë.",
  "item_sink.ponder.item_sink_basics.text_2": "Limpë i forya tolma carelya panta. Sasta mára nat mi i hyarya sambë.",
  "item_sink.ponder.item_sink_basics.text_3": "Cilina nati ar túvina telpe er lertalë. Cenya i nati-vista tengwi mi JEI.",
  "item_sink.ponder.item_sink_basics.text_4": "I tanwë maura Forge Energy (FE) ho túrë-carmë hya túrë-colca. Túrë tulë ho ilya palla; i túrë-tecë ná hyaryassë.",
  "item_sink.ponder.item_sink_basics.text_5": "I tanwë síla írë cára. I carmë-pilin quanta írë FE vanya. Lúmë ar FE nótë hilya i natwa mirwë.",
  "item_sink.ponder.item_sink_basics.text_6": "Mapa i telpe ho i atta forya sambi. Ilya telyaina carmë yuhta minë nat.",
  "item_sink.ponder.item_sink_basics.text_7": "I telyar nár telpi Create: Numismatics. Ú Numismatics, sasta outputItem mi item_sink-common.toml, nat túvina, ve minecraft:emerald.",
  "item_sink.ponder.item_sink_automation.header": "I nati-vistar cára immo",
  "item_sink.ponder.item_sink_automation.text_1": "Sasta mára nati yanna i tanwë as rumma. Sina taucolca ar rumma antat nati orontë.",
  "item_sink.ponder.item_sink_automation.text_2": "I attëa rumma mapa telpe mir taucolca. Er i atta etya sambi antat; úcarina nati harya i tanwë.",
  "item_sink.ponder.item_sink_automation.text_3": "Anta FE i tanwen írë cára. Nati, telpe ar FE tulir hya autar ho ilya palla.",
  "item_sink.ponder.item_sink_automation.text_4": "I carmë hauta írë lá sambë i telpen hya lá FE. Lerya i etya sambi ar anta túrë.",
  "item_sink.ponder.item_sink_automation.text_5": "Írë sambë i telpen ar fárëa FE nár, i carmë yesta ata immo.",
