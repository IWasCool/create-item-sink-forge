{
  "itemGroup.item_sink": "Yarating: Item Sink",
  "block.item_sink.item_sink": "Item Sink",
  "item_sink.ponder.item_sink_basics.header": "Item Sink yordamida",
  "item_sink.ponder.item_sink_basics.text_1": "Item Sink keraksiz narsalarni valyutaga aylantiradi, har bir qayta ishlash siklida bitta element.",
  "item_sink.ponder.item_sink_basics.text_2": "Mashinani ochish uchun o'ng tugmasini bosing. Qabul qilingan elementni chap tarafdagi kiritish uyasiga joylashtiring.",
  "item_sink.ponder.item_sink_basics.text_3": "Faqat valyuta chiqishi mavjud bo'lgan sozlangan kirishlar qabul qilinadi. JEI o'rnatilgan bo'lsa, Item Sink Conversion ta retseptni tekshiring.",
  "item_sink.ponder.item_sink_basics.text_4": "Odatiy bo'lib, Item Sink uchun generator yoki batareyadan Forge Energy (FE) kerak. Quvvat har qanday tomondan kirishi mumkin; energiya paneli ekranning chap tomonida joylashgan.",
  "item_sink.ponder.item_sink_basics.text_5": "Qayta ishlash vaqtida mashina yonadi. Davom etish strelkasi FE sarflaganda toʻldiriladi. Vaqt va FE xarajati elementning qiymat darajasiga bogʻliq.",
  "item_sink.ponder.item_sink_basics.text_6": "O'ngdagi ikkita chiqish joyidan valyutani yig'ing. Har bir tugallangan tsikl bitta kirish elementini sarflaydi.",
  "item_sink.ponder.item_sink_basics.text_7": "Standart chiqishlar Create: Numismatics tanga. Numismatics boʻlmasa, item_sink-common.toml da minecraft:emerald kabi oʻrnatilgan elementga outputItem raqamini oʻrnating.",
  "item_sink.ponder.item_sink_automation.header": "Item Sink ni avtomatlashtirish",
  "item_sink.ponder.item_sink_automation.text_1": "Qabul qilingan narsalarni huni bilan Item Sink ichiga yuboring. Ushbu ko'krak qafasi va huni yuqoridan kirish joyini ta'minlaydi.",
  "item_sink.ponder.item_sink_automation.text_2": "Ikkinchi bunker sandiqga valyuta chiqaradi. Avtomatlashtirish faqat ikkita chiqish uyasidan chiqariladi, shuning uchun ishlov berilmagan kirishlar ichkarida qoladi.",
  "item_sink.ponder.item_sink_automation.text_3": "Mashina ishlayotgan vaqtda FE taʼminlangan holda saqlang. Ob'ektni kiritish, valyutani chiqarish va FE kiritish har tomondan mavjud.",
  "item_sink.ponder.item_sink_automation.text_4": "Chiqish slotlari keyingi toʻlovga mos kelmasa yoki FE tugasa, ishlov berish toʻxtatiladi. Chiqishni aniq va mashinani quvvat bilan ta'minlang.",
  "item_sink.ponder.item_sink_automation.text_5": "Valyuta uchun joy va yetarlicha FE bo'lgandan so'ng, qayta ishlash avtomatik ravishda davom etadi.",
  "jei.item_sink.item_sink_conversion": "Item Sink Conversion",
