{
  "itemGroup.item_sink": "Create: Իրերի փոխարկիչ",
  "block.item_sink.item_sink": "Իրերի փոխարկիչ",
  "item_sink.ponder.item_sink_basics.header": "Օգտագործելով Իրերի փոխարկիչ",
  "item_sink.ponder.item_sink_basics.text_1": "Իրերի փոխարկիչ-ը անցանկալի իրերը վերածում են արժույթի, յուրաքանչյուր մշակման ցիկլում մեկ ապրանք:",
  "item_sink.ponder.item_sink_basics.text_2": "Աջ սեղմեք՝ մեքենան բացելու համար: Տեղադրեք ընդունված տարրը ձախ կողմում գտնվող մուտքի բնիկում:",
  "item_sink.ponder.item_sink_basics.text_3": "Ընդունվում են միայն կազմաձևված մուտքերը՝ հասանելի արժույթի թողարկմամբ: Տեղադրված JEI, ստուգեք Իրերի փոխարկում բաղադրատոմսեր:",
  "item_sink.ponder.item_sink_basics.text_4": "Լռելյայնորեն, Իրերի փոխարկիչ-ին անհրաժեշտ է Forge Energy (FE) գեներատորից կամ մարտկոցից: Հզորությունը կարող է մտնել ցանկացած կողմից. էներգիայի սանդղակը էկրանի ձախ կողմում է:",
  "item_sink.ponder.item_sink_basics.text_5": "Մեքենան լուսավորվում է մշակման ընթացքում: Առաջընթացի սլաքը լրացվում է, քանի որ այն սպառում է FE: Ժամանակը և FE արժեքը կախված են ապրանքի արժեքի մակարդակից:",
  "item_sink.ponder.item_sink_basics.text_6": "Հավաքեք արժույթը աջ կողմում գտնվող երկու ելքային անցքերից: Յուրաքանչյուր ավարտված ցիկլ սպառում է մեկ մուտքային տարր:",
  "item_sink.ponder.item_sink_basics.text_7": "Կանխադրված արդյունքները Create: Numismatics մետաղադրամներ են: Առանց Numismatics-ի, item_sink-common.toml-ում տեղադրեք outputItem, օրինակ՝ minecraft:emerald, item_sink-common.toml:",
  "item_sink.ponder.item_sink_automation.header": "Իրերի փոխարկիչ-ի ավտոմատացում",
  "item_sink.ponder.item_sink_automation.text_1": "Կերակրեք ընդունված իրերը Իրերի փոխարկիչ-ի մեջ վազվզողով: Այս կրծքավանդակը և ձողիկը ապահովում են մուտքի բնիկը վերևից:",
  "item_sink.ponder.item_sink_automation.text_2": "Երկրորդ վազվզող արտարժույթ է հանում կրծքավանդակի մեջ: Ավտոմատացումը քաղվում է միայն երկու ելքային անցքերից, ուստի չմշակված մուտքերը մնում են ներսում:",
  "item_sink.ponder.item_sink_automation.text_3": "Պահպանեք FE-ը, քանի դեռ մեքենան աշխատում է: Նյութերի տեղադրումը, արժույթի արդյունահանումը և FE մուտքագրումը հասանելի են յուրաքանչյուր կողմից:",
  "item_sink.ponder.item_sink_automation.text_4": "Մշակումը դադարում է, երբ ելքային անցքերը չեն համապատասխանում հաջորդ վճարմանը, կամ երբ FE-ը սպառվում է: Պահպանեք ելքը մաքուր և մեքենան միացված:",
  "item_sink.ponder.item_sink_automation.text_5": "Երբ արժույթի համար տեղ կա և բավարար FE, վերամշակումն ինքնաբերաբար կվերսկսվի:",
