{
  "itemGroup.item_sink": "Create: Igwe ntụgharị ihe",
  "block.item_sink.item_sink": "Igwe ntụgharị ihe",
  "item_sink.ponder.item_sink_basics.header": "Iji Igwe ntụgharị ihe",
  "item_sink.ponder.item_sink_basics.text_1": "Igwe ntụgharị ihe na-atụgharị ihe ndị a na-achọghị ka ọ bụrụ ego, otu ihe kwa usoro nhazi.",
  "item_sink.ponder.item_sink_basics.text_2": "Pịa aka nri iji mepee igwe. Tinye ihe anakwere na oghere ntinye n'aka ekpe.",
  "item_sink.ponder.item_sink_basics.text_3": "Naanị ntinye ahaziri nwere mmepụta ego dị ka anabatara. Site na arụnyere JEI, lelee ntuziaka Ntụgharị ihe.",
  "item_sink.ponder.item_sink_basics.text_4": "Site na ndabara, Igwe ntụgharị ihe chọrọ Forge Energy (FE) site na generator ma ọ bụ batrị. Ike nwere ike ịbanye n'akụkụ ọ bụla; ogwe ike dị n'aka ekpe nke ihuenyo ahụ.",
  "item_sink.ponder.item_sink_basics.text_5": "Igwe na-enwu ọkụ mgbe ọ na-arụ ọrụ. Ọganihu ọganihu na-ejupụta ka ọ na-eri FE. Oge na FE na-eri na-adabere n'ọkwa uru ihe ahụ.",
  "item_sink.ponder.item_sink_basics.text_6": "Anakọta ego site na oghere abụọ mmepụta n'aka nri. okirikiri nke ọ bụla emechara na-eri otu ihe ntinye.",
  "item_sink.ponder.item_sink_basics.text_7": "mpụta mbụ bụ mkpụrụ ego Create: Numismatics. Enweghị Numismatics, tọọ outputItem na ihe arụnyere, dị ka minecraft:emerald, na item_sink-common.toml.",
  "item_sink.ponder.item_sink_automation.header": "na-akpaghị aka na Igwe ntụgharị ihe",
  "item_sink.ponder.item_sink_automation.text_1": "Nri anabatara ihe n'ime Igwe ntụgharị ihe nwere hopper. Igbe a na hopper na-enye oghere ntinye si n'elu.",
  "item_sink.ponder.item_sink_automation.text_2": "Hopper nke abụọ na-ewepụta ego n'ime igbe. Akpaaka na-ewepụta naanị site na oghere mmepụta abụọ ahụ, yabụ ntinye anaghị arụ ọrụ na-anọ n'ime.",
  "item_sink.ponder.item_sink_automation.text_3": "Debe FE wetara mgbe igwe na-agba ọsọ. Ntinye ihe, ntinye ego na ntinye FE dị n'akụkụ ọ bụla.",
  "item_sink.ponder.item_sink_automation.text_4": "Nhazi kwụsịtụrụ mgbe oghere mmepụta enweghị ike dabara n'ụgwọ na-esote, ma ọ bụ mgbe FE kwụsịrị. Mee ka mmepụta ahụ doo anya na igwe na-arụ ọrụ.",
  "item_sink.ponder.item_sink_automation.text_5": "Ozugbo enwere ohere maka ego na ezuru FE, nhazi na-amalite na-akpaghị aka.",
