{
  "itemGroup.item_sink": "Create: Sakumwandlar",
  "block.item_sink.item_sink": "Sakumwandlar",
  "item_sink.ponder.item_sink_basics.header": "Bruk sakumwandlarn",
  "item_sink.ponder.item_sink_basics.text_1": "Sakumwandlarn djär um saker du int wil åvå til pengar. Ien sak brukes i war arbeðsrunda.",
  "item_sink.ponder.item_sink_basics.text_2": "Trykk yöger knapp för at uöpp masjin. Lägg ien passand sak i platjen til winster.",
  "item_sink.ponder.item_sink_basics.text_3": "Bar instelld saker min pengar so finns ut kan takas in. Sjå sakumwandlingsrecept i JEI.",
  "item_sink.ponder.item_sink_basics.text_4": "Masjin biegär vanlitwis Forge Energy (FE) frå generator eld batteri. Straum kan kuma in frå oll siður; energibalken ir til winster.",
  "item_sink.ponder.item_sink_basics.text_5": "Masjin lysser mend on arbeðer. Framganggspiln fylls mend FE brukes. Tið og energikostnad beror åv sakns wärde.",
  "item_sink.ponder.item_sink_basics.text_6": "Tak pengarna frå di två platjerna til yöger. War färdug runda brukar ien sak.",
  "item_sink.ponder.item_sink_basics.text_7": "Vanlit utfall ir mynt frå Create: Numismatics. Utan Numismatics, ställ outputItem i item_sink-common.toml til ien installerad sak, som minecraft:emerald.",
  "item_sink.ponder.item_sink_automation.header": "Sakumwandlarn arbeðer sjålwer",
  "item_sink.ponder.item_sink_automation.text_1": "Bruk ien tratt för at gävå passand saker in. Dena tjista og tratt fyller in frå uvå.",
  "item_sink.ponder.item_sink_automation.text_2": "Ien onn tratt flytter pengar til ien tjista. Automatiken tar bar frå di två utplatjerna; uarbeðad saker stann in.",
  "item_sink.ponder.item_sink_automation.text_3": "Gäv masjin FE mend on arbeðer. Saker in, pengar ut og FE in fungerar åv oll siður.",
  "item_sink.ponder.item_sink_automation.text_4": "Arbeðet stanner um nästa betalning int får rum eld FE ir slut. Åv utplatjerna fria og gäv masjin straum.",
  "item_sink.ponder.item_sink_automation.text_5": "Når pengar får rum og noð FE finns, byrer arbeðet sjålwer igän.",
