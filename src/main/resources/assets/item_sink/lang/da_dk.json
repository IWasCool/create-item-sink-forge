{
  "itemGroup.item_sink": "Create: Genstandsomformer",
  "block.item_sink.item_sink": "Genstandsomformer",
  "item_sink.ponder.item_sink_basics.header": "Brug af Genstandsomformer",
  "item_sink.ponder.item_sink_basics.text_1": "De Genstandsomformer omdanner uønskede varer til valuta, én vare pr. behandlingscyklus.",
  "item_sink.ponder.item_sink_basics.text_2": "Højreklik for at åbne maskinen. Placer et accepteret element i indgangsåbningen til venstre.",
  "item_sink.ponder.item_sink_basics.text_3": "Kun konfigurerede indgange med en tilgængelig valutaudgang accepteres. Med JEI installeret, tjek Genstandsomformning opskrifter.",
  "item_sink.ponder.item_sink_basics.text_4": "Som standard har Genstandsomformer brug for Forge Energy (FE) fra en generator eller et batteri. Strøm kan trænge ind gennem enhver side; energibaren er til venstre på skærmen.",
  "item_sink.ponder.item_sink_basics.text_5": "Maskinen lyser under behandling. Fremskridtspilen fyldes, efterhånden som den bruger FE. Tid og FE omkostninger afhænger af varens værdilag.",
  "item_sink.ponder.item_sink_basics.text_6": "Saml valutaen fra de to udgangspladser til højre. Hver afsluttet cyklus bruger et inputelement.",
  "item_sink.ponder.item_sink_basics.text_7": "Standard output er Create: Numismatics mønter. Uden Numismatics, sæt outputItem til et installeret element, såsom minecraft:emerald, i item_sink-common.toml.",
  "item_sink.ponder.item_sink_automation.header": "Automatisering af Genstandsomformer",
  "item_sink.ponder.item_sink_automation.text_1": "Før accepterede varer ind i Genstandsomformer med en tragt. Denne kiste og tragt forsyner indgangsåbningen fra oven.",
  "item_sink.ponder.item_sink_automation.text_2": "En anden tragt trækker penge ud i en kiste. Automatisering udtrækker kun fra de to output-slots, så ubehandlede input bliver inde.",
  "item_sink.ponder.item_sink_automation.text_3": "Hold FE leveret, mens maskinen kører. Vareindsættelse, valutaudtræk og FE input er tilgængelige på alle sider.",
  "item_sink.ponder.item_sink_automation.text_4": "Behandlingen stopper, når outputslots ikke kan passe til den næste udbetaling, eller når FE løber tør. Hold udgangen fri og maskinen tændt.",
  "item_sink.ponder.item_sink_automation.text_5": "Når der er plads til valutaen og nok FE, genoptages behandlingen automatisk.",
