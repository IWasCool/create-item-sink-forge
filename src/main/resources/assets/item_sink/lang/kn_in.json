{
  "itemGroup.item_sink": "Create: ವಸ್ತು ಪರಿವರ್ತಕ",
  "block.item_sink.item_sink": "ವಸ್ತು ಪರಿವರ್ತಕ",
  "item_sink.ponder.item_sink_basics.header": "ವಸ್ತು ಪರಿವರ್ತಕ ಬಳಸಿ",
  "item_sink.ponder.item_sink_basics.text_1": "ವಸ್ತು ಪರಿವರ್ತಕ ಅನಗತ್ಯ ವಸ್ತುಗಳನ್ನು ಕರೆನ್ಸಿಯಾಗಿ ಪರಿವರ್ತಿಸುತ್ತದೆ, ಪ್ರತಿ ಸಂಸ್ಕರಣಾ ಚಕ್ರಕ್ಕೆ ಒಂದು ಐಟಂ.",
  "item_sink.ponder.item_sink_basics.text_2": "ಯಂತ್ರವನ್ನು ತೆರೆಯಲು ಬಲ ಕ್ಲಿಕ್ ಮಾಡಿ. ಎಡಭಾಗದಲ್ಲಿರುವ ಇನ್‌ಪುಟ್ ಸ್ಲಾಟ್‌ನಲ್ಲಿ ಅಂಗೀಕರಿಸಿದ ಐಟಂ ಅನ್ನು ಇರಿಸಿ.",
  "item_sink.ponder.item_sink_basics.text_3": "ಲಭ್ಯವಿರುವ ಕರೆನ್ಸಿ ಔಟ್‌ಪುಟ್‌ನೊಂದಿಗೆ ಕಾನ್ಫಿಗರ್ ಮಾಡಿದ ಇನ್‌ಪುಟ್‌ಗಳನ್ನು ಮಾತ್ರ ಸ್ವೀಕರಿಸಲಾಗುತ್ತದೆ. JEI ಅನ್ನು ಸ್ಥಾಪಿಸಿದ ನಂತರ, ವಸ್ತು ಪರಿವರ್ತನೆ ಪಾಕವಿಧಾನಗಳನ್ನು ಪರಿಶೀಲಿಸಿ.",
  "item_sink.ponder.item_sink_basics.text_4": "ಡಿಫಾಲ್ಟ್ ಆಗಿ, ವಸ್ತು ಪರಿವರ್ತಕ ಗೆ ಜನರೇಟರ್ ಅಥವಾ ಬ್ಯಾಟರಿಯಿಂದ Forge Energy (FE) ಅಗತ್ಯವಿದೆ. ಶಕ್ತಿಯು ಯಾವುದೇ ಬದಿಯ ಮೂಲಕ ಪ್ರವೇಶಿಸಬಹುದು; ಎನರ್ಜಿ ಬಾರ್ ಪರದೆಯ ಎಡಭಾಗದಲ್ಲಿದೆ.",
  "item_sink.ponder.item_sink_basics.text_5": "ಪ್ರಕ್ರಿಯೆಗೊಳಿಸುವಾಗ ಯಂತ್ರವು ಬೆಳಗುತ್ತದೆ. ಪ್ರಗತಿ ಬಾಣವು FE ಅನ್ನು ಬಳಸುವುದರಿಂದ ತುಂಬುತ್ತದೆ. ಸಮಯ ಮತ್ತು FE ವೆಚ್ಚವು ಐಟಂನ ಮೌಲ್ಯದ ಶ್ರೇಣಿಯನ್ನು ಅವಲಂಬಿಸಿರುತ್ತದೆ.",
  "item_sink.ponder.item_sink_basics.text_6": "ಬಲಭಾಗದಲ್ಲಿರುವ ಎರಡು ಔಟ್‌ಪುಟ್ ಸ್ಲಾಟ್‌ಗಳಿಂದ ಕರೆನ್ಸಿಯನ್ನು ಸಂಗ್ರಹಿಸಿ. ಪ್ರತಿ ಪೂರ್ಣಗೊಂಡ ಚಕ್ರವು ಒಂದು ಇನ್‌ಪುಟ್ ಐಟಂ ಅನ್ನು ಬಳಸುತ್ತದೆ.",
  "item_sink.ponder.item_sink_basics.text_7": "ಡೀಫಾಲ್ಟ್ ಔಟ್‌ಪುಟ್‌ಗಳು Create: Numismatics ನಾಣ್ಯಗಳಾಗಿವೆ. Numismatics ಇಲ್ಲದೆ, item_sink-common.toml ರಲ್ಲಿ minecraft:emerald ನಂತಹ ಸ್ಥಾಪಿಸಲಾದ ಐಟಂಗೆ outputItem ಅನ್ನು ಹೊಂದಿಸಿ.",
  "item_sink.ponder.item_sink_automation.header": "ವಸ್ತು ಪರಿವರ್ತಕ ಅನ್ನು ಸ್ವಯಂಚಾಲಿತಗೊಳಿಸಲಾಗುತ್ತಿದೆ",
  "item_sink.ponder.item_sink_automation.text_1": "ಸ್ವೀಕರಿಸಿದ ವಸ್ತುಗಳನ್ನು ವಸ್ತು ಪರಿವರ್ತಕ ಗೆ ಹಾಪರ್‌ನೊಂದಿಗೆ ಫೀಡ್ ಮಾಡಿ. ಈ ಎದೆ ಮತ್ತು ಹಾಪರ್ ಮೇಲಿನಿಂದ ಇನ್ಪುಟ್ ಸ್ಲಾಟ್ ಅನ್ನು ಪೂರೈಸುತ್ತದೆ.",
  "item_sink.ponder.item_sink_automation.text_2": "ಎರಡನೇ ಹಾಪರ್ ಎದೆಯೊಳಗೆ ಕರೆನ್ಸಿಯನ್ನು ಹೊರತೆಗೆಯುತ್ತದೆ. ಆಟೊಮೇಷನ್ ಎರಡು ಔಟ್‌ಪುಟ್ ಸ್ಲಾಟ್‌ಗಳಿಂದ ಮಾತ್ರ ಹೊರತೆಗೆಯುತ್ತದೆ, ಆದ್ದರಿಂದ ಸಂಸ್ಕರಿಸದ ಇನ್‌ಪುಟ್‌ಗಳು ಒಳಗೆ ಉಳಿಯುತ್ತವೆ.",
  "item_sink.ponder.item_sink_automation.text_3": "ಯಂತ್ರ ಚಾಲನೆಯಲ್ಲಿರುವಾಗ FE ಅನ್ನು ಸರಬರಾಜು ಮಾಡಿ. ಐಟಂ ಅಳವಡಿಕೆ, ಕರೆನ್ಸಿ ಹೊರತೆಗೆಯುವಿಕೆ ಮತ್ತು FE ಇನ್‌ಪುಟ್ ಪ್ರತಿ ಬದಿಯಲ್ಲಿ ಲಭ್ಯವಿದೆ.",
  "item_sink.ponder.item_sink_automation.text_4": "ಔಟ್‌ಪುಟ್ ಸ್ಲಾಟ್‌ಗಳು ಮುಂದಿನ ಪಾವತಿಗೆ ಹೊಂದಿಕೆಯಾಗದಿದ್ದಾಗ ಅಥವಾ FE ರನ್ ಔಟ್ ಆದಾಗ ಪ್ರಕ್ರಿಯೆಯು ವಿರಾಮಗೊಳ್ಳುತ್ತದೆ. ಔಟ್ಪುಟ್ ಅನ್ನು ಸ್ಪಷ್ಟವಾಗಿ ಇರಿಸಿ ಮತ್ತು ಯಂತ್ರವು ಚಾಲಿತವಾಗಿದೆ.",
  "item_sink.ponder.item_sink_automation.text_5": "ಒಮ್ಮೆ ಕರೆನ್ಸಿಗೆ ಸ್ಥಳಾವಕಾಶವಿದೆ ಮತ್ತು ಸಾಕಷ್ಟು FE, ಪ್ರಕ್ರಿಯೆಯು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಪುನರಾರಂಭಗೊಳ್ಳುತ್ತದೆ.",
