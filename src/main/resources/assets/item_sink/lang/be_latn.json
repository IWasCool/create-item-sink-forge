{
  "itemGroup.item_sink": "Create: Pjeraŭtvaralnik pradmjetaŭ",
  "block.item_sink.item_sink": "Pjeraŭtvaralnik pradmjetaŭ",
  "item_sink.ponder.item_sink_basics.header": "Vykarystoŭvajučy Pjeraŭtvaralnik pradmjetaŭ",
  "item_sink.ponder.item_sink_basics.text_1": "Pjeraŭtvaralnik pradmjetaŭ pieratvaraje niepažadanyja pradmiety ŭ vałiutu, adzin ełiemient za cykł apracoŭki.",
  "item_sink.ponder.item_sink_basics.text_2": "Pstryknicie pravaj knopkaj myšy, kab adkryć mašynu. Zmiescicie pryniaty pradmiet va ŭvachodny słot złieva.",
  "item_sink.ponder.item_sink_basics.text_3": "Prymajucca tolki skanfihuravanyja ŭvody z dastupnaj vałiutaj. Z ustałiavanym JEI praviercie Pjeraŭtvarennje pradmjetaŭ receptaŭ.",
  "item_sink.ponder.item_sink_basics.text_4": "Pa zmaŭčanni Pjeraŭtvaralnik pradmjetaŭ patrabuie Forge Energy (FE) ad hienieratara abo batarei. Mahutnasć moža pastupać z łiuboha boku; panel enierhii znachodzicca ŭ łievaj častcy ekrana.",
  "item_sink.ponder.item_sink_basics.text_5": "Mašyna zaharajecca padčas apracoŭki. Strełka prahresu zapaŭniajecca pa miery spažyvannia FE. Čas i košt FE załiežać ad uzroŭniu kaštoŭnasci pradmieta.",
  "item_sink.ponder.item_sink_basics.text_6": "Zbiarycie vałiutu z dvuch vychodnych słotaŭ sprava. Kožny zavieršany cykł spažyvaje adzin uvachodny ełiemient.",
  "item_sink.ponder.item_sink_basics.text_7": "Vychady pa zmaŭčanni - Create: Numismatics maniet. Bjez Numismatics ustałiujcie outputItem dłia ŭstałiavanaha ełiemienta, naprykład minecraft:emerald, u item_sink-common.toml.",
  "item_sink.ponder.item_sink_automation.header": "Aŭtamatyzacyja Pjeraŭtvaralnik pradmjetaŭ",
  "item_sink.ponder.item_sink_automation.text_1": "Padajcie pryniatyja pradmiety ŭ Pjeraŭtvaralnik pradmjetaŭ z bunkieram. Hety kufar i bunkier zabiaspiečvajuć uvachodnuiu ščyłinu zvierchu.",
  "item_sink.ponder.item_sink_automation.text_2": "Druhi bunkier zdabyvaje vałiutu ŭ kufar. Aŭtamatyzacyja zdabyvaje tolki z dvuch vychadnych słotaŭ, tamu nieapracavanyja ŭvachody zastajucca ŭnutry.",
  "item_sink.ponder.item_sink_automation.text_3": "Zachoŭvajcie FE, pakul mašyna pracuie. Ustaŭka pradmietaŭ, zdabyča vałiuty i ŭvod FE dastupnyja z kožnaha boku.",
  "item_sink.ponder.item_sink_automation.text_4": "Apracoŭka prypyniajecca, kałi vychadnyja słoty nie zmiaščajucca z nastupnaj vypłataj abo kałi FE zakančvajecca. Zachoŭvajcie vychad čystym, a mašyna padkłiučanaj.",
  "item_sink.ponder.item_sink_automation.text_5": "Kałi josć miesca dłia vałiuty i dastatkova FE, apracoŭka adnaŭłiajecca aŭtamatyčna.",
