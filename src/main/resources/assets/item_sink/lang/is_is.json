{
  "itemGroup.item_sink": "Create: Hlutabreytir",
  "block.item_sink.item_sink": "Hlutabreytir",
  "item_sink.ponder.item_sink_basics.header": "Með því að nota Hlutabreytir",
  "item_sink.ponder.item_sink_basics.text_1": "Hlutabreytir breyta óæskilegum hlutum í gjaldmiðil, einn hlut í hverri vinnslulotu.",
  "item_sink.ponder.item_sink_basics.text_2": "Hægrismelltu til að opna vélina. Settu samþykktan hlut í inntaksraufina vinstra megin.",
  "item_sink.ponder.item_sink_basics.text_3": "Aðeins er tekið við stilltum inntakum með tiltækan gjaldmiðilsúttak. Með JEI uppsett, athugaðu Umbreyting hluta uppskriftir.",
  "item_sink.ponder.item_sink_basics.text_4": "Sjálfgefið þarf Hlutabreytir Forge Energy (FE) frá rafal eða rafhlöðu. Kraftur getur farið inn um hvaða hlið sem er; orkustikan er vinstra megin á skjánum.",
  "item_sink.ponder.item_sink_basics.text_5": "Vélin kviknar við vinnslu. Framvinduörin fyllist þegar hún eyðir FE. Tími og FE kostnaður fer eftir gildisflokki vörunnar.",
  "item_sink.ponder.item_sink_basics.text_6": "Safnaðu gjaldmiðlinum úr úttakspámunum tveimur til hægri. Hver lokið lota eyðir einum inntakshlut.",
  "item_sink.ponder.item_sink_basics.text_7": "Sjálfgefin úttak er Create: Numismatics mynt. Án Numismatics, stilltu outputItem á uppsettan hlut, eins og minecraft:emerald, í item_sink-common.toml.",
  "item_sink.ponder.item_sink_automation.header": "Sjálfvirkur Hlutabreytir",
  "item_sink.ponder.item_sink_automation.text_1": "Færðu samþykkta hluti í Hlutabreytir með töppu. Þessi kista og hylki veita inntaksraufinni að ofan.",
  "item_sink.ponder.item_sink_automation.text_2": "Annar tankur dregur gjaldeyri í kistu. Sjálfvirkni dregur aðeins út úr úttaksraufunum tveimur, þannig að óunnið inntak er inni.",
  "item_sink.ponder.item_sink_automation.text_3": "Hafðu FE til staðar meðan vélin er í gangi. Hlutainnsetning, gjaldeyrisútdráttur og FE inntak eru í boði á öllum hliðum.",
  "item_sink.ponder.item_sink_automation.text_4": "Vinnslan gerir hlé þegar úttakspásarnir passa ekki við næstu útborgun, eða þegar FE klárast. Haltu úttakinu hreinu og vélinni knúinni.",
  "item_sink.ponder.item_sink_automation.text_5": "Þegar pláss er fyrir gjaldmiðilinn og nóg FE, fer vinnslan sjálfkrafa af stað.",
  "jei.item_sink.item_sink_conversion": "Umbreyting hluta",
