{
  "itemGroup.item_sink": "Create: Konvertitur tal-oġġetti",
  "block.item_sink.item_sink": "Konvertitur tal-oġġetti",
  "item_sink.ponder.item_sink_basics.header": "Bl-użu tat-Konvertitur tal-oġġetti",
  "item_sink.ponder.item_sink_basics.text_1": "It-Konvertitur tal-oġġetti jibdlu oġġetti mhux mixtieqa f'munita, oġġett wieħed għal kull ċiklu ta 'proċessar.",
  "item_sink.ponder.item_sink_basics.text_2": "Ikklikkja bil-lemin biex tiftaħ il-magna. Poġġi oġġett aċċettat fl-islott tad-dħul fuq ix-xellug.",
  "item_sink.ponder.item_sink_basics.text_3": "Inputs konfigurati biss b'output ta' munita disponibbli huma aċċettati. B'JEI installat, iċċekkja Konverżjoni tal-oġġetti riċetta.",
  "item_sink.ponder.item_sink_basics.text_4": "B'mod awtomatiku, l-Konvertitur tal-oġġetti jeħtieġ Forge Energy (FE) minn ġeneratur jew batterija. Il-qawwa tista 'tidħol minn kull naħa; il-bar tal-enerġija tinsab fuq ix-xellug tal-iskrin.",
  "item_sink.ponder.item_sink_basics.text_5": "Il-magna tixgħel waqt l-ipproċessar. Il-vleġġa tal-progress timla hekk kif tikkonsma FE. Il-ħin u l-ispiża FE jiddependu fuq il-livell tal-valur tal-oġġett.",
  "item_sink.ponder.item_sink_basics.text_6": "Iġbor il-munita miż-żewġ slots tal-ħruġ fuq il-lemin. Kull ċiklu komplut jikkonsma oġġett wieħed input.",
  "item_sink.ponder.item_sink_basics.text_7": "L-outputs default huma Create: Numismatics muniti. Mingħajr Numismatics, issettja outputItem għal oġġett installat, bħal minecraft:emerald, f'item_sink-common.toml.",
  "item_sink.ponder.item_sink_automation.header": "Awtomatizzazzjoni tal-Konvertitur tal-oġġetti",
  "item_sink.ponder.item_sink_automation.text_1": "Għalf oġġetti aċċettati fil-Konvertitur tal-oġġetti b'delu. Dan is-sider u hopper jipprovdu l-islott tad-dħul minn fuq.",
  "item_sink.ponder.item_sink_automation.text_2": "It-tieni delu jiġbed il-munita ġo kaxxa. L-awtomazzjoni toħroġ biss miż-żewġ slots tal-ħruġ, għalhekk l-inputs mhux ipproċessati jibqgħu ġewwa.",
  "item_sink.ponder.item_sink_automation.text_3": "Żomm FE fornut waqt li l-magna taħdem. L-inserzjoni tal-oġġett, l-estrazzjoni tal-munita u l-input FE huma disponibbli fuq kull naħa.",
  "item_sink.ponder.item_sink_automation.text_4": "L-ipproċessar jieqaf meta s-slots tal-output ma jkunux jistgħu joqogħdu mal-ħlas li jmiss, jew meta FE jispiċċa. Żomm l-output ċara u l-magna mħaddma.",
  "item_sink.ponder.item_sink_automation.text_5": "Ladarba jkun hemm lok għall-munita u biżżejjed FE, l-ipproċessar jerġa' jibda awtomatikament.",
