{
  "itemGroup.item_sink": "Create: Objektu bihurgailua",
  "block.item_sink.item_sink": "Objektu bihurgailua",
  "item_sink.ponder.item_sink_basics.header": "Objektu bihurgailua erabiliz",
  "item_sink.ponder.item_sink_basics.text_1": "Objektu bihurgailua-k nahi ez diren elementuak moneta bihurtzen ditu, elementu bat prozesatzeko ziklo bakoitzeko.",
  "item_sink.ponder.item_sink_basics.text_2": "Egin klik eskuineko botoiarekin makina irekitzeko. Jarri onartutako elementu bat ezkerreko sarrerako zirrikituan.",
  "item_sink.ponder.item_sink_basics.text_3": "Moneta-irteera erabilgarri bat duten konfiguratutako sarrerak soilik onartzen dira. JEI instalatuta, egiaztatu Objektuen bihurketa errezeta.",
  "item_sink.ponder.item_sink_basics.text_4": "Lehenespenez, Objektu bihurgailua-k Forge Energy (FE) behar du sorgailu edo bateria batetik. Boterea edozein aldetik sar daiteke; energia-barra pantailaren ezkerraldean dago.",
  "item_sink.ponder.item_sink_basics.text_5": "Makina pizten da prozesatzen ari den bitartean. Aurrerapen-gezia FE kontsumitzen duen heinean betetzen da. Denbora eta FE kostua elementuaren balio-mailaren araberakoak dira.",
  "item_sink.ponder.item_sink_basics.text_6": "Bildu moneta eskuineko bi irteerako zirrikituetatik. Amaitutako ziklo bakoitzak sarrerako elementu bat kontsumitzen du.",
  "item_sink.ponder.item_sink_basics.text_7": "Irteera lehenetsiak Create: Numismatics txanpon dira. Numismatics gabe, ezarri outputItem instalatutako elementu batean, adibidez, minecraft:emerald, item_sink-common.toml-n.",
  "item_sink.ponder.item_sink_automation.header": "Objektu bihurgailua automatizatzea",
  "item_sink.ponder.item_sink_automation.text_1": "Sartu onartutako elementuak Objektu bihurgailuara toltza batekin. Kutxa eta hopper honek sarrerako zirrikitua hornitzen du goitik.",
  "item_sink.ponder.item_sink_automation.text_2": "Bigarren hopper batek dirua kutxa batean ateratzen du. Automatizazioak bi irteerako zirrikituetatik bakarrik ateratzen ditu, beraz, prozesatu gabeko sarrerak barruan geratzen dira.",
  "item_sink.ponder.item_sink_automation.text_3": "Mantendu FE hornituta makina martxan dagoen bitartean. Elementuak txertatzea, moneta ateratzea eta FE sarrera eskuragarri daude alde guztietan.",
  "item_sink.ponder.item_sink_automation.text_4": "Prozesatzeko eten egiten da irteerako zirrikituak hurrengo ordainketara egokitu ezin direnean edo FE agortzen denean. Mantendu irteera argia eta makina piztuta.",
  "item_sink.ponder.item_sink_automation.text_5": "Monetarako tokia dagoenean eta FE nahikoa dagoenean, prozesatzea automatikoki hasiko da.",
