{
  "itemGroup.item_sink": "Create: Gjenstandsomformer",
  "block.item_sink.item_sink": "Gjenstandsomformer",
  "item_sink.ponder.item_sink_basics.header": "Ved å bruke Gjenstandsomformer",
  "item_sink.ponder.item_sink_basics.text_1": "Gjenstandsomformer gjør uønskede varer til valuta, ett element per behandlingssyklus.",
  "item_sink.ponder.item_sink_basics.text_2": "Høyreklikk for å åpne maskinen. Plasser et akseptert element i inngangssporet til venstre.",
  "item_sink.ponder.item_sink_basics.text_3": "Kun konfigurerte innganger med tilgjengelig valutautgang aksepteres. Med JEI installert, sjekk Gjenstandsomforming oppskrifter.",
  "item_sink.ponder.item_sink_basics.text_4": "Som standard trenger Gjenstandsomformer Forge Energy (FE) fra en generator eller et batteri. Kraft kan komme inn gjennom hvilken som helst side; energibaren er til venstre på skjermen.",
  "item_sink.ponder.item_sink_basics.text_5": "Maskinen lyser under behandling. Fremdriftspilen fylles etter hvert som den forbruker FE. Tid og FE kostnad avhenger av varens verdinivå.",
  "item_sink.ponder.item_sink_basics.text_6": "Samle inn valutaen fra de to utgangslukene til høyre. Hver fullførte syklus bruker ett inngangselement.",
  "item_sink.ponder.item_sink_basics.text_7": "Standard utganger er Create: Numismatics mynter. Uten Numismatics, sett outputItem til et installert element, for eksempel minecraft:emerald, i item_sink-common.toml.",
  "item_sink.ponder.item_sink_automation.header": "Automatisering av Gjenstandsomformer",
  "item_sink.ponder.item_sink_automation.text_1": "Mater aksepterte varer inn i Gjenstandsomformer med en trakt. Denne kisten og trakten forsyner inngangsåpningen ovenfra.",
  "item_sink.ponder.item_sink_automation.text_2": "En annen trakt trekker ut valuta i en kiste. Automatisering trekker bare ut fra de to utgangssporene, slik at ubehandlede innganger forblir inne.",
  "item_sink.ponder.item_sink_automation.text_3": "Hold FE levert mens maskinen går. Vareinnsetting, valutautvinning og FE-inndata er tilgjengelig på alle sider.",
  "item_sink.ponder.item_sink_automation.text_4": "Behandlingen stopper når utgangssporene ikke passer til neste utbetaling, eller når FE går tom. Hold utgangen klar og maskinen drevet.",
  "item_sink.ponder.item_sink_automation.text_5": "Når det er plass til valutaen og nok FE, fortsetter behandlingen automatisk.",
