{
  "itemGroup.item_sink": "Create: Przetwornik rzeczy",
  "block.item_sink.item_sink": "Przetwornik rzeczy",
  "item_sink.ponder.item_sink_basics.header": "Używanie Przetwornik rzeczy",
  "item_sink.ponder.item_sink_basics.text_1": "Przetwornik rzeczy przekształcajōm niychciane elymynta we waluta, jedyn elymynt na cykl przetworzanio.",
  "item_sink.ponder.item_sink_basics.text_2": "Kliknij prawym klikiym, coby ôtworzyć maszina. Umiyść zaakceptowany elymynt we ôtworu wejściowym po lewyj zajcie.",
  "item_sink.ponder.item_sink_basics.text_3": "Akceptuje sie ino skōnfigurowane wejścia z dostympnym wyjściym waluty. Z zainstalowanōm JEI, sprawdź Przetworzenie rzeczy receptōw.",
  "item_sink.ponder.item_sink_basics.text_4": "Domyślnie Przetwornik rzeczy potrzebuje Forge Energy (FE) z gyneratora abo baterije. Władza może wejść bez kożdo strōna; pas ynergije je po lewyj zajcie ekranu.",
  "item_sink.ponder.item_sink_basics.text_5": "Maszina zaświyci sie w czasie przetworzanio. Strzałka postympu wypołnio sie, kej pochłōnio FE. Czas i FE koszty zależōm ôd poziōmu wertu przedmiotu.",
  "item_sink.ponder.item_sink_basics.text_6": "Zbiyraj waluta z dwōch slotōw wyjściowych po prawyj. Kożdy zakōńczōny cykl pochłōnio jedyn elymynt wejściowy.",
  "item_sink.ponder.item_sink_basics.text_7": "Wyjścia domyślne to Create: Numismatics mōnet. Bez Numismatics ustaw outputItem na zainstalowany elymynt, taki jak minecraft:emerald, w item_sink-common.toml.",
  "item_sink.ponder.item_sink_automation.header": "Autōmatyzacyjo Przetwornik rzeczy",
  "item_sink.ponder.item_sink_automation.text_1": "Przekludzaj przijynte przedmioty do Przetwornik rzeczy ze zbiornikōm. Ta skrzynia i zbiornika lifrujōm ôtwōr wejściowy ôd wiyrchu.",
  "item_sink.ponder.item_sink_automation.text_2": "Drugi zbiornik pociōngo waluta do skrzynie. Autōmatyzacyjo pobiyro ino z dwōch slotōw wyjściowych, tōż niyprzetworzōne wejścia ôstowajōm we postrzodku.",
  "item_sink.ponder.item_sink_automation.text_3": "Trzimaj FE w czasie roboty masziny. Wkludzanie przedmiotu, wydobycie waluty i wejście FE sōm dostympne po kożdyj zajcie.",
  "item_sink.ponder.item_sink_automation.text_4": "Przetworzanie zatrzymuje sie, kej sloty wyjściowe niy mogōm pasuć do nastympnyj wypłaty abo kej FE sie kōńczy. Trzimaj wyjście jasne i maszina zasilano.",
  "item_sink.ponder.item_sink_automation.text_5": "Kej je miyjsce na waluta i styknie FE, przetworzanie wznowo sie autōmatycznie.",
