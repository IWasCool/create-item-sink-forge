{
  "itemGroup.item_sink": "Create: Lutomformar",
  "block.item_sink.item_sink": "Lutomformar",
  "item_sink.ponder.item_sink_basics.header": "Bruke lutsomformaren",
  "item_sink.ponder.item_sink_basics.text_1": "Lutomformaren gjer uønskte lutar om til valuta, éin lut per arbeidssyklus.",
  "item_sink.ponder.item_sink_basics.text_2": "Høgreklikk for å opne maskini. Legg ein godkjend lut i innmatingsplassen til venstre.",
  "item_sink.ponder.item_sink_basics.text_3": "Berre oppsette inndata med tilgjengeleg valuta blir godtekne. Sjå oppskriftene for lutsomforming i JEI.",
  "item_sink.ponder.item_sink_basics.text_4": "Som standard treng maskini Forge Energy (FE) frå ein generator eller eit batteri. Straum kan førast inn frå alle sider. Energimålaren er til venstre på skjermen.",
  "item_sink.ponder.item_sink_basics.text_5": "Maskina lyser medan ho arbeider. Framdriftspila blir fylt når FE blir brukt. Tid og energikostnad kjem an på verdinivået til luten.",
  "item_sink.ponder.item_sink_basics.text_6": "Hent valutaen frå dei to utmatingsplassane til høgre. Kvar fullførte syklus bruker éin lut.",
  "item_sink.ponder.item_sink_basics.text_7": "Standardutdata er myntar frå Create: Numismatics. Utan Numismatics må du setje outputItem til ein installert lut, som minecraft:emerald, i item_sink-common.toml.",
  "item_sink.ponder.item_sink_automation.header": "Automatisere lutsomformaren",
  "item_sink.ponder.item_sink_automation.text_1": "Mat inn godkjende lutar med ei trekt. Denne kista og trekta fyller innmatingsplassen ovanfrå.",
  "item_sink.ponder.item_sink_automation.text_2": "Ei anna trekt fører valutaen til ei kiste. Automatisk uttak bruker berre dei to utmatingsplassane, så ubehandla lutar blir verande inne.",
  "item_sink.ponder.item_sink_automation.text_3": "Hald maskini forsynt med FE. Innmating av lutar, uttak av valuta og tilførsel av FE fungerer på alle sider.",
  "item_sink.ponder.item_sink_automation.text_4": "Arbeidet stansar om det ikkje er plass til neste utbetaling, eller om FE tek slutt. Hald utmatinga fri og maskini forsynt med straum.",
  "item_sink.ponder.item_sink_automation.text_5": "Arbeidet held fram automatisk når det er plass til valutaen og nok FE.",
