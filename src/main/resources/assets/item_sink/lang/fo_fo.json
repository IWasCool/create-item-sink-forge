{
  "itemGroup.item_sink": "Create: Lutumbroytari",
  "block.item_sink.item_sink": "Lutumbroytari",
  "item_sink.ponder.item_sink_basics.header": "Við at brúka Lutumbroytari",
  "item_sink.ponder.item_sink_basics.text_1": "Tey Lutumbroytari gera óynsktar lutir til gjaldoyra, ein lutur pr.",
  "item_sink.ponder.item_sink_basics.text_2": "Høgraklikk fyri at lata maskinuna upp. Set ein góðkendan lutur í inntøkurúmið til vinstru.",
  "item_sink.ponder.item_sink_basics.text_3": "Einans uppsettar inntøkur við tøkum gjaldoyraútflutningi eru góðtiknar. Við JEI uppsettum, kanna Lutaumbroyting uppskriftir.",
  "item_sink.ponder.item_sink_basics.text_4": "Sum standard hevur Lutumbroytari brúk fyri Forge Energy (FE) frá einum generatori ella battaríi. Vald kann koma inn gjøgnum hvørja síðu; orkustrikan er til vinstru á skerminum.",
  "item_sink.ponder.item_sink_basics.text_5": "Maskinan tendrar, meðan hon verður virkað. Framgongdarpílurin fyllir, tá hann brúkar FE. Tíð og FE kostnaður eru treytað av virðisstiginum á lutunum.",
  "item_sink.ponder.item_sink_basics.text_6": "Savna gjaldoyrað frá teimum báðum útgangsplássunum til høgru. Hvør liðug ringrás brúkar ein inntøkulut.",
  "item_sink.ponder.item_sink_basics.text_7": "Forsett úttøkur eru Create: Numismatics myntir. Uttan Numismatics, set outputItem til ein innsettan lutur, so sum minecraft:emerald, í item_sink-common.toml.",
  "item_sink.ponder.item_sink_automation.header": "Sjálvvirkandi Lutumbroytari",
  "item_sink.ponder.item_sink_automation.text_1": "Fóður góðtiknar lutir inn í Lutumbroytari við trappu. Hendan bringan og trappan veita inntaksspælið omanfrá.",
  "item_sink.ponder.item_sink_automation.text_2": "Ein annar trampa dregur gjaldoyra út í eina kistu. Sjálvvirkan dregur bert úr teimum báðum útgangsplássunum, so óviðgjørd inntøkur halda seg inni.",
  "item_sink.ponder.item_sink_automation.text_3": "Halt FE við, meðan maskinan koyrir. Lutinnseting, gjaldoyraútvinning og FE inntøka eru tøk á hvørjari síðu.",
  "item_sink.ponder.item_sink_automation.text_4": "Viðgerðin steðgar, tá útgangsplássini ikki kunnu passa til næstu útgjaldið, ella tá FE er liðugt. Halt útgangin kláran og maskinuna drivna.",
  "item_sink.ponder.item_sink_automation.text_5": "Tá pláss er fyri gjaldoyranum og nóg mikið FE, byrjar avgreiðslan uppaftur sjálvvirkandi.",
  "jei.item_sink.item_sink_conversion": "Lutaumbroyting",
