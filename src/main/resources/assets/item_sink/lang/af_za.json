{
  "itemGroup.item_sink": "Create: Voorwerpverwerker",
  "block.item_sink.item_sink": "Voorwerpverwerker",
  "item_sink.ponder.item_sink_basics.header": "Gebruik die Voorwerpverwerker",
  "item_sink.ponder.item_sink_basics.text_1": "Die Voorwerpverwerker verander ongewenste items in geldeenheid, een item per verwerkingsiklus.",
  "item_sink.ponder.item_sink_basics.text_2": "Regskliek om die masjien oop te maak. Plaas 'n aanvaarde item in die invoergleuf aan die linkerkant.",
  "item_sink.ponder.item_sink_basics.text_3": "Slegs gekonfigureerde insette met 'n beskikbare geldeenheid-uitset word aanvaar. Met JEI geïnstalleer, gaan Voorwerpomskakeling resepte na.",
  "item_sink.ponder.item_sink_basics.text_4": "By verstek benodig die Voorwerpverwerker Forge Energy (FE) van 'n kragopwekker of battery. Krag kan deur enige kant inkom; die energiebalk is aan die linkerkant van die skerm.",
  "item_sink.ponder.item_sink_basics.text_5": "Die masjien brand tydens verwerking. Die vorderingspyltjie vul soos dit FE verbruik. Tyd en FE koste hang af van die item se waardevlak.",
  "item_sink.ponder.item_sink_basics.text_6": "Versamel die geldeenheid uit die twee uitsetgleuwe aan die regterkant. Elke voltooide siklus verbruik een insetitem.",
  "item_sink.ponder.item_sink_basics.text_7": "Verstek uitsette is Create: Numismatics munte. Sonder Numismatics, stel outputItem op 'n geïnstalleerde item, soos minecraft:emerald, in item_sink-common.toml.",
  "item_sink.ponder.item_sink_automation.header": "Outomatisering van die Voorwerpverwerker",
  "item_sink.ponder.item_sink_automation.text_1": "Voer aanvaarde items in die Voorwerpverwerker met 'n hopper. Hierdie bors en hopper voorsien die insetgleuf van bo af.",
  "item_sink.ponder.item_sink_automation.text_2": "'n Tweede hopper onttrek geldeenheid in 'n kis. Outomatisering onttrek slegs uit die twee uitsetgleuwe, so onverwerkte insette bly binne.",
  "item_sink.ponder.item_sink_automation.text_3": "Hou FE verskaf terwyl die masjien loop. Item invoeging, geldeenheid onttrekking en FE invoer is beskikbaar aan elke kant.",
  "item_sink.ponder.item_sink_automation.text_4": "Verwerking pouses wanneer die uitsetgleuwe nie by die volgende uitbetaling kan pas nie, of wanneer FE opraak. Hou die uitset skoon en die masjien aangedryf.",
  "item_sink.ponder.item_sink_automation.text_5": "Sodra daar plek is vir die geldeenheid en genoeg FE, hervat verwerking outomaties.",
