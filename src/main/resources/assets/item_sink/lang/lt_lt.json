{
  "itemGroup.item_sink": "Create: Daiktų keitiklis",
  "block.item_sink.item_sink": "Daiktų keitiklis",
  "item_sink.ponder.item_sink_basics.header": "Naudojant Daiktų keitiklis",
  "item_sink.ponder.item_sink_basics.text_1": "Daiktų keitiklis nepageidaujamas prekes paverčia valiuta, po vieną prekę per apdorojimo ciklą.",
  "item_sink.ponder.item_sink_basics.text_2": "Dešiniuoju pelės mygtuku spustelėkite, kad atidarytumėte įrenginį. Įdėkite priimtą elementą į įvesties angą kairėje.",
  "item_sink.ponder.item_sink_basics.text_3": "Priimamos tik sukonfigūruotos įvestys su galima valiutos išvestimi. Įdiegę JEI patikrinkite Daiktų keitimas receptų.",
  "item_sink.ponder.item_sink_basics.text_4": "Pagal numatytuosius nustatymus Daiktų keitiklis reikia Forge Energy (FE) iš generatoriaus arba akumuliatoriaus. Galia gali patekti per bet kurią pusę; energijos juosta yra kairėje ekrano pusėje.",
  "item_sink.ponder.item_sink_basics.text_5": "Apdorojant mašina užsidega. Eigos rodyklė užpildoma, kai sunaudojama FE. Laikas ir FE kaina priklauso nuo prekės vertės pakopos.",
  "item_sink.ponder.item_sink_basics.text_6": "Surinkite valiutą iš dviejų išvesties lizdų dešinėje. Kiekvienas užbaigtas ciklas sunaudoja vieną įvesties elementą.",
  "item_sink.ponder.item_sink_basics.text_7": "Numatytoji išvestis yra Create: Numismatics moneta. Be Numismatics, outputItem nustatykite kaip įdiegtą elementą, pvz., minecraft:emerald, item_sink-common.toml.",
  "item_sink.ponder.item_sink_automation.header": "Daiktų keitiklis automatizavimas",
  "item_sink.ponder.item_sink_automation.text_1": "Priimtas prekes įdėkite į Daiktų keitiklis su bunkeriu. Ši dėžė ir bunkeris tiekia įvesties angą iš viršaus.",
  "item_sink.ponder.item_sink_automation.text_2": "Antrasis bunkeris ištraukia valiutą į skrynią. Automatika ištraukia tik iš dviejų išvesties lizdų, todėl neapdoroti įėjimai lieka viduje.",
  "item_sink.ponder.item_sink_automation.text_3": "Laikykite FE pateiktą, kol mašina veikia. Prekės įterpimas, valiutos ištraukimas ir FE įvestis yra prieinami kiekvienoje pusėje.",
  "item_sink.ponder.item_sink_automation.text_4": "Apdorojimas sustabdomas, kai išvesties lizdai netelpa į kitą išmokėjimą arba kai baigiasi FE. Laikykite išvestį švarią ir mašiną maitinkite.",
  "item_sink.ponder.item_sink_automation.text_5": "Atsiradus valiutai ir pakankamai FE, apdorojimas atnaujinamas automatiškai.",
