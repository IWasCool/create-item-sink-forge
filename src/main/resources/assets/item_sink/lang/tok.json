{
  "itemGroup.item_sink": "Create: ilo pi weka ijo",
  "block.item_sink.item_sink": "ilo pi weka ijo",
  "item_sink.ponder.item_sink_basics.header": "kepeken ilo pi weka ijo",
  "item_sink.ponder.item_sink_basics.text_1": "ilo li kama e ijo pi wile ala tawa mani. tenpo pali wan li moku e ijo wan.",
  "item_sink.ponder.item_sink_basics.text_2": "o luka e nena pi poka nanpa tu la ilo li open. o pana e ijo pona lon poki kama pi poka nanpa wan.",
  "item_sink.ponder.item_sink_basics.text_3": "ijo li wile lon lawa pali. mani ona li wile lon. o lukin e nasin ante ijo lon JEI.",
  "item_sink.ponder.item_sink_basics.text_4": "tenpo lawa la ilo li wile e Forge Energy (FE) tan ilo wawa anu poki wawa. wawa li ken kama tan poka ale. linja wawa li lon poka nanpa wan.",
  "item_sink.ponder.item_sink_basics.text_5": "ilo pali li suno. linja pali li suli li moku e FE. tenpo pali en mute FE li tan suli mani pi ijo.",
  "item_sink.ponder.item_sink_basics.text_6": "o kama jo e mani tan poki tawa tu lon poka nanpa tu. pali wan pini li moku e ijo kama wan.",
  "item_sink.ponder.item_sink_basics.text_7": "mani lawa li mani pi Create: Numismatics. Numismatics li lon ala la o ante e outputItem lon item_sink-common.toml tawa ijo lon, sama minecraft:emerald.",
  "item_sink.ponder.item_sink_automation.header": "ilo li pali taso",
  "item_sink.ponder.item_sink_automation.text_1": "o pana e ijo pona kepeken ilo pana. poki ni en ilo pana ni li pana e ijo tan sewi tawa poki kama.",
  "item_sink.ponder.item_sink_automation.text_2": "ilo pana ante li tawa e mani tawa poki. ilo li ken kama jo tan poki tawa tu taso. ijo pi pali ala li awen insa.",
  "item_sink.ponder.item_sink_automation.text_3": "o pana e FE tawa ilo pali. ijo li ken kama, mani li ken weka, FE li ken kama tan poka ale.",
  "item_sink.ponder.item_sink_automation.text_4": "poki tawa li jo ala e ma pi mani kama anu FE li pini la pali li awen. o weka e mani. o pana e wawa.",
  "item_sink.ponder.item_sink_automation.text_5": "ma mani en FE mute li lon la ilo li open sin e pali ona.",
